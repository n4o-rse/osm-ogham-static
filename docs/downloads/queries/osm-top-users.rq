PREFIX oosp: <https://n4o-rse.github.io/osm-ogham-static/prop/>
PREFIX oospq: <https://n4o-rse.github.io/osm-ogham-static/prop/qualifier/>

SELECT ?user (COUNT(?version) AS ?versions) (COUNT(DISTINCT ?item) AS ?elements) WHERE {
  ?item oosp:P101 ?version .
  ?version oospq:P105 ?user .
}
GROUP BY ?user
ORDER BY DESC(?versions) ?user
LIMIT 20
