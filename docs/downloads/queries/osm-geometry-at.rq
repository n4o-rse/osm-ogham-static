PREFIX oosp: <https://n4o-rse.github.io/osm-ogham-static/prop/>
PREFIX oospq: <https://n4o-rse.github.io/osm-ogham-static/prop/qualifier/>
PREFIX oosps: <https://n4o-rse.github.io/osm-ogham-static/prop/statement/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>

#defaultView:Map
SELECT ?item ?label ?geometry ?since WHERE {
  ?item oosp:P111 ?entry ;
        rdfs:label ?label .
  ?entry oosps:P111 ?geometry ;
         oospq:P103 ?since .
  FILTER(LANG(?label) = "en")
  FILTER(?since <= "2023-01-01T00:00:00Z")
  FILTER NOT EXISTS {
    ?item oosp:P111 ?later .
    ?later oospq:P103 ?laterSince .
    FILTER(?laterSince > ?since && ?laterSince <= "2023-01-01T00:00:00Z")
  }
}
ORDER BY ?label ?item
LIMIT 200
